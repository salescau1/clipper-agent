# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Virtualenv. `.whisperx-venv` WAJIB ada di sini: isinya 2,1 GB (torch + model
# pyannote). Dulu hanya `.venv/` yang dikecualikan, dan itu lubang besar —
# `git add .` pertama langsung menyertakan 2 GB dependensi.
.venv/
.whisperx-venv/
venv/

# Environment & secrets
.env

# Runtime output
output/
cache/
logs/
temp/
final/

# Aset berat yang bukan bagian desain UI. `sfx` = 14 MB file suara yang bisa
# diunduh/diganti kapan saja; menaruhnya di git membengkakkan repo tanpa manfaat.
# Font, frame, dan overlay TETAP ikut karena itu bagian dari tampilan yang disepakati.
assets/sfx/

# Video & SRT uji coba. Dua MP4 di sini berukuran 75 MB dan 93 MB — di atas batas
# 100 MB GitHub per file kalau nanti bertambah, dan tidak ada gunanya di riwayat.
# PNG contoh frame tetap ikut karena itu referensi desain.
sampleframe/*.mp4
sampleframe/*.srt

# Berkas bawaan installer portabel. Ini DIBAWA installer, bukan bagian sumber:
# `python-embed/` & `python-embed-whisperx/` (Python embeddable), `ffmpeg/` (biner
# ffmpeg+ffprobe), dan `models/` (cache HuggingFace ~3,9 GB dari bundel model ke-2).
# Kalau folder-folder ini kebetulan ada di folder pengembangan (mis. saat menguji
# resolver di bundled_paths.py), jangan sampai ikut ter-commit.
python-embed/
python-embed-whisperx/
ffmpeg/
models/

# Karantina hasil tools/cleanup.py (bisa dihapus manual kalau sudah yakin)
_trash_*/

# Isi folder karantina TIDAK boleh masuk git walau namanya kebetulan cocok
# dengan pola yang di-track (mis. _trash_*/tests/, _trash_*/tools/).

# KUNCI API mentah. `deepgram.txt` & `inceptionlabs.txt` isinya nama layanan + token
# telanjang (ditemukan 2026-09-03 saat mau commit). Kunci TIDAK BOLEH masuk riwayat git —
# sekali ter-commit ia tetap ada di riwayat walau filenya dihapus belakangan.
# Tempat yang benar untuk kunci adalah `.env` (sudah diabaikan di atas).
deepgram.txt
inceptionlabs.txt
*.key
*_token.txt

# Berkas kerja desain (Photoshop dll). Bukan aset yang dipakai runtime, ukurannya besar,
# dan berubah tiap kali disentuh -> membengkakkan riwayat tanpa manfaat.
*.psd

# Video hasil uji di root proyek (mis. sample_deepgram_kdm_subtitled.mp4 @ 51 MB).
# Sekelas dengan aturan sampleframe/*.mp4 di atas.
sample_*.mp4

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Test artifacts
.pytest_cache/
.coverage
htmlcov/