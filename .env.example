# Copy this file to `.env` and fill in your values.
# Never commit the real `.env` file.

# LLM Provider (9Router / OpenAI-compatible endpoint)
# For 9Router with Antigravity → Gemini Pro:
LLM_BASE_URL=http://localhost:20128/v1
GEMINI_API_KEY=your_9router_api_key_here

# Optional overrides (defaults shown)
# GEMINI_MODEL=gemini-2.0-flash
# Ukuran model Whisper: tiny/base/small/medium/large-v3.
# `medium` = default. Jangan turunkan ke `small` untuk video berbahasa Sunda /
# audio lapangan: model kecil sering salah dengar dan memicu looping kata.
# WHISPER_MODEL=medium
# TARGET_HEIGHT=1080
# YTDLP_PLAYER_CLIENT=android,ios
# DOWNLOAD_RETRIES=3
# DOWNLOAD_RETRY_DELAY=5.0